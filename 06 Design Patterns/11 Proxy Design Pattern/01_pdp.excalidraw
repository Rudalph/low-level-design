      "isDeleted": false,
      "boundElements": null,
      "updated": 1795252997993,
      "link": null,
      "locked": false,
      "text": "Delays the creation or loading of an expensive object until it is actually needed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Delays the creation or loading of an expensive object until it is actually needed.",
