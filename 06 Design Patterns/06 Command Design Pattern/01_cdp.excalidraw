      "updated": 1794946155871,
      "link": null,
      "locked": false,
      "text": "Instead of keeping Fan and light \nseperate classes under command",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instead of keeping Fan and light \nseperate classes under command",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "unTg8p_IsUe1mwAKPq2b4",
      "type": "text",
      "x": 1039.3803404795513,
      "y": 1937.9643484387536,
      "width": 447.7396240234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 2042260155,
      "version": 525,
      "versionNonce": 1113284571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794946245434,
      "link": null,
      "locked": false,
      "text": "But this will break LISKOV principal \nas different appliances has different features\nFan: on, off, speed\nlight: on, off, brightness\nheater, on, off, temperature",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But this will break LISKOV principal \nas different appliances has different features\nFan: on, off, speed\nlight: on, off, brightness\nheater, on, off, temperature",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0eXCBvHRqYgqMvvL94bWJ",
      "type": "text",
      "x": 1033.3774210447637,
      "y": 2114.359879870616,
      "width": 456.2596435546875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1212900949,
      "version": 320,
      "versionNonce": 511301621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794946302367,
      "link": null,
      "locked": false,
      "text": "And appliances class along cant handle all this \nand we wont be able to replace parent class \nwith child class",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And appliances class along cant handle all this \nand we wont be able to replace parent class \nwith child class",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
