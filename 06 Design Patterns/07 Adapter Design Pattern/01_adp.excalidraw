    {
      "id": "pwJBTz-gTn_rtP127hSf-",
      "type": "text",
      "x": 31.55836068796384,
      "y": 2735.6532275119034,
      "width": 946.4592895507812,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 720692331,
      "version": 611,
      "versionNonce": 1161633579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794955205724,
      "link": null,
      "locked": false,
      "text": "This is object adapter we also have class adapter which is exactly same\nIn object adapter: Adapter class has is-a relation with Target and has-a relation with adptee\nIn class adapter: Adapter class has is-a relation with both target and adptee (Inheritance only)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is object adapter we also have class adapter which is exactly same\nIn object adapter: Adapter class has is-a relation with Target and has-a relation with adptee\nIn class adapter: Adapter class has is-a relation with both target and adptee (Inheritance only)",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
